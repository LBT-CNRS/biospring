C_C4   RC  C5' C4' H4' O4' C3'
C_C4   C   C5' C4' H4' O4' C3'
C_O4   RC  C4' O4' C1'
C_O4   C   C4' O4' C1'
C_C1   RC  O4' C1' H1' C2' N1
C_C1   C   O4' C1' H1' C2' N1
C_C2   RC  C1' C2' H2'1 H2' O2' C3'
C_C2   C   C1' C2' H2'1 H2' O2' C3'
C_O2   RC  C2' O2' HO'2 HO2'
C_O2   C   C2' O2' HO'2 HO2'
C_C3   RC  C2' C3' H3' C4' O3'
C_C3   C   C2' C3' H3' C4' O3'
C_O3   RC  C3' O3' +P
C_O3   C   C3' O3' +P
C_BN1   RC  N1 C1' C2 C6
