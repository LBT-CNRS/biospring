#Molecular Simulation Parameter file
# be careful of the syntax : parameter<space>=<space>value

# -----------------------------------
#fs
simulation.timestep  = 2.5
simulation.nbsteps = -1
#simulation.samplerate = 1

pdbtrajectory.enable = 0
pdbtrajectory.path = traj.pdb
pdbtrajectory.frequency = 1

csvsampling.enable = 0
csvsampling.path = sample.csv
csvsampling.frequency = 1

# -----------------------------------
spring.enable = 1
#dimensionless factor applied to each spring's stiffness (kJ.mol-1.A-2, set
#by pdb2spn's --stiffness at topology creation time, here 1.0)
spring.scale = 10.0

# -----------------------------------
viscosity.enable = 1
#Da.fs-1
viscosity.value = 0.1

# -----------------------------------
steric.enable = 1
#dimensionless factor applied to steric forces
steric.gridscale = 1.0
#Angstroms
steric.cutoff = 8.0

coulomb.enable = 0
#dimensionless factor applied to electrostatic forces
coulomb.scale = 1.0
#dimensionless (relative permittivity)
coulomb.dielectric = 40.0
#Angstroms
coulomb.cutoff = 16.0


# contraint parameters not available yet
#constraint.enable = 1
#constraint.src = arg_41_selection
#constraint.dest = thr_138_selection
#constraint.module = 0.001
