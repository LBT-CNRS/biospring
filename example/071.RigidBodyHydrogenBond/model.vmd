#!/usr/local/bin/vmd
# 071.RigidBodyHydrogenBond - visualization
#
# model.nc.pdb carries CONECT records for every rigid-body spring (see
# pdb2spn --pdbconect in the Makefile). Loaded with filebonds 1, autobonds 0
# so every bond drawn is exactly one of those springs -- nothing guessed
# from interatomic distances, nothing missing.
#
# Atom names here are amber.grp's renamed types (e.g. glutamate's backbone N
# is "EN", not "N" -- see the Makefile's GRP/FF). VMD's built-in secondary
# structure calculation (STRIDE) only recognizes the standard backbone names
# N/CA/C/O, so the block below renames just those four atoms back to their
# standard names, residue type by residue type (side chains keep their
# renamed names, which the donor/acceptor selections below still rely on).
# This runs once at load time; renaming survives the whole interactive
# session since IMD only ever updates coordinates, never atom names.

mol new model.nc.pdb type pdb first 0 last -1 step 1 filebonds 1 autobonds 0 waitfor all
mol delrep 0 top

foreach {resname prefix} {ALA A GLU E LYS K GLY G SER S ASN N THR T VAL V LEU L ILE I} {
    foreach atomtype {N CA C O} {
        set sel [atomselect top "resname $resname and name ${prefix}${atomtype}"]
        $sel set name $atomtype
    }
}
mol ssrecalc top

# Donor/acceptor role selections (data/reducerules/amber.hbond): now that
# backbone N/O are renamed back to their standard names, only side-chain
# donor/acceptor atoms need to be listed explicitly here.
set donor_only "N RNE RNH1 RNH2 NND2 QNE2 KNZ WNE1"
set acceptor_only "O NOD1 DOD1 DOD2 QOE1 EOE1 EOE2"
set both "CSG HND1 HNE2 SOG TOG1 YOH"

# Representation 1: NewCartoon colored by secondary structure (STRIDE,
# recalculated live every frame during the interactive IMD session) -- the
# actual point of this example: watch whether the unfolded chain regains a
# purple helix ribbon (residues 1-10) and a yellow sheet ribbon (residues
# 21-29) as --hbond finds and holds the right backbone hydrogen bonds.
mol representation NewCartoon
mol color Structure
mol selection {all}
mol material Opaque
mol addrep top

# Representation 2-5: classic ball-and-stick (CPK), colored by hydrogen-bond
# role instead of by element, same convention as before:
#   - Grey: not a donor or acceptor.
#   - Blue: donor only -- matches the classic CPK convention for nitrogen.
#   - Red: acceptor only -- matches the classic CPK convention for oxygen.
#   - Purple: both donor and acceptor (Ser/Thr/Tyr hydroxyls) -- a blend of
#     the two colors above.
mol representation CPK 0.6 0.2 12.0 12.0
mol color ColorID 2
mol selection "all and not (name $donor_only or name $acceptor_only or name $both)"
mol material Opaque
mol addrep top

mol representation CPK 0.6 0.2 12.0 12.0
mol color ColorID 0
mol selection "name $donor_only"
mol material Opaque
mol addrep top

mol representation CPK 0.6 0.2 12.0 12.0
mol color ColorID 1
mol selection "name $acceptor_only"
mol material Opaque
mol addrep top

mol representation CPK 0.6 0.2 12.0 12.0
mol color ColorID 11
mol selection "name $both"
mol material Opaque
mol addrep top

# Representation 6: thin orange overlay (Bonds) highlighting the rigid-body
# spring network itself, same as 070.RigidBodyRotamere.
mol representation Bonds 0.08 12.0
mol color ColorID 3
mol selection {all}
mol material Opaque
mol addrep top

mol rename top helix_loop_sheet

# VMD only recalculates STRIDE secondary structure at load time, not
# automatically on every subsequent frame -- without this, the NewCartoon
# coloring above would freeze at whatever assignment the starting
# (unfolded) structure got, defeating the point of watching it live.
proc _071_ssrecalc {args} { mol ssrecalc top }
trace add variable ::vmd_frame([molinfo top get id]) write _071_ssrecalc

display projection Orthographic
display depthcue off
display rendermode GLSL
color Display Background white
axes location off

menu imd on
imd transfer 1000
imd connect localhost 3000
