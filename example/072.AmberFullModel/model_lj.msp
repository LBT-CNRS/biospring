#072.AmberFullModel, stage 2/4 -- BONDED + STERIC (Lennard-Jones)
#
#Stage 1 plus real steric exclusion: AMBER's Lennard-Jones 12-6, on the real
#per-atom radii/epsilons assigned by --grp amber.grp + --nonbondedinteraction
#amber.nbi.ff.
#
#NAMING CAVEAT, worth knowing: the mode below is spelled
#"lennard-jones-8-6Amber", but the potential it actually implements
#(steric_energy_amber / steric_force_module_amber) is a classic LJ 12-6,
#matching the real AMBER force field -- the "8-6" in the name is factually
#wrong and is fixed on the branch fix/rename-lennard-jones-amber-12-6
#(mode renamed to "lennard-jones-12-6Amber"). Use the 8-6 spelling here as
#long as that branch is not merged; the other modes (Lewitt, Zacharias) ARE
#genuinely 8-6.
#
#What this stage adds physically: atoms can no longer pass through each
#other, so pulling a side chain now feels real packing resistance.

#fs. Real AMBER masses (via --grp amber.grp) and rigid-body springs much
#stiffer than a soft elastic network: 1.5 fs is the validated working value
#(a 1.5-2.5 fs sweep was run on this very structure -- all stable, clean
#monotonic relaxation; 1.5 keeps a comfortable margin).
simulation.timestep = 1.5
simulation.nbsteps = -1

#Da.fs-1. Low friction so the structure reacts immediately to interactive
#pulling instead of being damped away. NOTE this is viscosity WITHOUT a
#random force: the dynamics is a quench, not a thermostatted NVT ensemble --
#do not read equilibrium populations off these runs.
viscosity.enable = 1
viscosity.value = 0.01

spring.enable = 1
spring.scale = 1.0

#Per-family runtime switches, all on by default. They only gate families
#that were actually BUILT (see the -dihedral* flags in the Makefile): a
#family not built has no spring to enable either way. Handy to isolate one
#term's contribution to the reported energy channels without rebuilding.
dihedralphi.enable = 1
dihedralpsi.enable = 1
dihedralomega.enable = 1
dihedralchi.enable = 1

#Steric exclusion: real AMBER LJ 12-6 (see the naming caveat above).
#gridscale/cutoff drive the neighbour-search grid; 8 A is the usual working
#cutoff for a 12-6 whose attractive tail is already negligible there.
steric.enable = 1
steric.gridscale = 1.0
steric.cutoff = 8.0
steric.mode = lennard-jones-8-6Amber
