# This example needs the --rigidbody/--bondedinteraction options,
# data/reducerules/ProteinAtomRigidGroups.rbody +
# data/reducerules/ProteinAtomBonded.bi.ff, the -dihedralplanarity flag and
# the hbond mechanism -- none of which are part of any released BioSpring
# build yet: no Docker image has them, so there is no Makefile.docker here
# (unlike the other example/ subdirectories) -- a local build is required.

PDB2SPN = pdb2spn
BIOSPRING = biospring

# BS_DATA_DIR points at the forcefield/reduce-rule data bundled with a local
# BioSpring install: source <biospring_install_path>/bin/BioSpring-config.sh
# first to set BioSpring_DATA_PATH (see doc/BUILDING.md).
BS_DATA_DIR = $(BioSpring_DATA_PATH)

# ProteinAtomRigidGroups.rbody: springs-only rotamer/hinge mechanism (all
# pairwise springs within each named rigid-body group instead of a distance
# cutoff). It is the permanent substrate the bonded parameters below retune
# and extend -- never replaced. Note omega is deliberately RIGID here: its
# _PHI/_PSI cliques span the whole peptide plane, freezing omega at whatever
# value the input structure carries (cis stays cis, trans stays trans --
# spring equilibria are the distances measured at load time).
RIGIDBODY = $(BS_DATA_DIR)/reducerules/ProteinAtomRigidGroups.rbody

# ProteinAtomBonded.bi.ff: real AMBER ff99SB bonded parameters, generated by
# scripts/generate_bonded_forcefield.py -- STRETCH (real bonds retuned in
# place), BEND (1-3 via ghost particles), and every dihedral family
# including the ghost-particle rings for phi/psi/omega/chi1-5, the
# methyl/hydroxyl/ammonium rotors, Asn/Gln amides, Arg guanidinium, the Pro
# ring and the aromatic rings, plus the PLANARITY impropers holding those
# rings flat. See doc/BondedForceFieldSprings.md.
BONDED = $(BS_DATA_DIR)/reducerules/ProteinAtomBonded.bi.ff

# amber.grp/amber.nbi.ff: a one-atom-per-rule identity mapping (not a real
# coarse-grain reduction) used to assign real per-atom AMBER masses, partial
# charges and LJ radii/epsilons. Since it renames particles (e.g. Glu's N ->
# EN), pdb2spn reuses this same --grp file as the naming-translation table
# for --rigidbody and --bondedinteraction, so both can still find atoms
# under their original PDB names.
GRP = $(BS_DATA_DIR)/reducerules/amber.grp
FF = $(BS_DATA_DIR)/forcefield/amber.nbi.ff

# Rigid-body springs stand in for real bonds and valence angles, not a soft
# elastic network: much stiffer than a cutoff-based model. This value holds
# every one of them -- the .bi.ff adds torsion wells on top and nothing
# else. 8000 kJ/mol/A^2 is the validated setting (see 073's README).
STIFFNESS = 8000.0

# example/001_GKinase's own structure, copied here to keep this example
# self-contained: 183 residues, 2814 atoms, and the only structure in the
# repository containing ALL 20 standard amino acids -- so it exercises every
# rule in the .bi.ff at once, Trp's indole rings and Cys included.
PDB = gkinase.pdb

NC = model.nc
NC_PDB = model.nc.pdb

# MDDriver options
# -wait, if the simulation server has to wait for client connection before starting (no value: presence = wait)
# -port port
# -debug debug level : 0 no log - 2 verbose log
# -log logfilename
IMDLOG = mddriver.log
IMDOPT = -wait -port 3000 -debug 0 -log $(IMDLOG)

prep : $(NC) $(NC_PDB)

# One .nc for all four stages: the bonded families are a BUILD-time choice
# (a family not requested here never gets a spring created at all), while
# steric/coulomb/hbond are RUNTIME choices living in the .msp files. So the
# four run targets below differ only by their .msp -- no rebuild needed to
# move between stages.
#
# -dihedral is the shorthand for -dihedralbackbone + -dihedralsidechain +
# -dihedralplanarity together; spell them out instead to build only part of
# the dihedral model.
$(NC) : $(PDB)
	$(PDB2SPN) -s $(PDB) -o $(NC) --grp $(GRP) --nonbondedinteraction $(FF) \
	    --rigidbody $(RIGIDBODY) --bondedinteraction $(BONDED) \
	    --dihedral --stiffness $(STIFFNESS)

# PDB of the network with CONECT records for every spring, for
# visualization. Passing --stiffness again just restates the existing
# springs' own value (read from $(NC)); no cutoff/rigidbody is given, so no
# new spring is created at this step.
$(NC_PDB) : $(NC)
	$(PDB2SPN) -s $(NC) -o $(NC_PDB) --pdbconect --stiffness $(STIFFNESS)

# ---------------------------------------------------------------------------
# The four stages, cumulative. Each adds one interaction family to the
# previous one; run them in order to feel what each term actually
# contributes. Single-threaded step rates measured on this structure:
# bonded ~550/s, full ~6/s -- the non-bonded neighbour search dominates, not
# the spring model (see the README's performance note).
# ---------------------------------------------------------------------------

# Stage 1: bonded only (every dihedral family).
run-bonded : $(NC)
	$(BIOSPRING) -nc $(NC) -msp model_bonded.msp $(IMDOPT)

# Stage 2: + steric exclusion, real AMBER Lennard-Jones 12-6 (spelled
# "lennard-jones-8-6Amber" in the .msp -- see the caveat in model_lj.msp).
run-lj : $(NC)
	$(BIOSPRING) -nc $(NC) -msp model_lj.msp $(IMDOPT)

# Stage 3: + Coulomb electrostatics on the real AMBER partial charges.
run-lj-coulomb : $(NC)
	$(BIOSPRING) -nc $(NC) -msp model_lj_coulomb.msp $(IMDOPT)

# Stage 4: + dynamic hydrogen bonds -- the complete model.
run-full : $(NC)
	$(BIOSPRING) -nc $(NC) -msp model_full.msp $(IMDOPT)

# Default interactive target: the complete model.
run : run-full

# Same as run-full but does not wait for an MDDriver client first.
run_now : $(NC)
	$(BIOSPRING) -nc $(NC) -msp model_full.msp -port 3000 -debug 0 -log $(IMDLOG)

vis : $(NC_PDB)
	vmd -e model.vmd

gdb : $(NC)
	gdb --args $(BIOSPRING) -nc $(NC) -msp model_full.msp $(IMDOPT)

clean :
	rm -rf $(NC) $(NC_PDB) $(IMDLOG)

.PHONY : prep run run_now run-bonded run-lj run-lj-coulomb run-full vis gdb clean
