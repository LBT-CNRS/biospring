#075.RNAHairpin -- dynamics settings.

#fs. SHORTER than the protein examples' 1.5, for two independent reasons:
#the rigid-body mesh runs at --stiffness 3000 here (a spring N times stiffer
#needs a timestep divided by sqrt(N)), and every particle carries mass 1 Da
#because no .grp maps nucleic atoms onto real masses yet -- a carbon at 1 Da
#instead of 12 vibrates faster than the real one. 0.3 fs is stable; 1.0 fs
#blows up ("Found non-finite position").
simulation.timestep = 0.3
simulation.nbsteps = -1
simulation.samplerate = 2000

#Da.fs-1. Low friction, so the structure answers interactive pulling instead
#of being damped away. NOTE this is viscosity WITHOUT a random force: the
#dynamics is a quench, not a thermostatted ensemble -- so conformational
#POPULATIONS are not something this model predicts, only whether a state it
#starts in is preserved.
viscosity.enable = 1
viscosity.value = 0.01

spring.enable = 1
spring.scale = 1.0

bending.enable = 1
dihedralnucleicbackbone.enable = 1
dihedralnucleicchi.enable = 1
dihedralnucleicsugar.enable = 1
dihedralplanarity.enable = 1
