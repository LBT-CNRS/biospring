#073.BondedStages -- shared by all three stages, deliberately.
#
#The stages differ ONLY by how their .nc was built (see the Makefile). Using
#one .msp for all three is what makes the comparison honest: any difference
#in the reported energies comes from the model, never from the run settings.

#fs. Real AMBER masses (via --grp amber.grp) and rigid-body springs much
#stiffer than a soft elastic network; 1.5 fs is the validated working value.
simulation.timestep = 1.5
simulation.nbsteps = -1

#Da.fs-1. Low friction, so the structure answers interactive pulling instead
#of being damped away. NOTE this is viscosity WITHOUT a random force: the
#dynamics is a quench, not a thermostatted ensemble.
viscosity.enable = 1
viscosity.value = 0.01

spring.enable = 1
spring.scale = 1.0

#All five bonded-family switches left ON. They isolate a family's
#contribution inside a given build -- they do NOT turn stage 3 back into
#stage 1, which is exactly why this example ships three .nc files. See
#doc/MSP_Options.md.
dihedralphi.enable = 1
dihedralpsi.enable = 1
dihedralomega.enable = 1
dihedralchi.enable = 1
dihedralplanarity.enable = 1
