#074.DNADuplex -- point energy only: timestep 0, one step, nothing moves.
#
#Every number this prints depends on the model and the input conformation
#alone, never on the run settings.

simulation.timestep = 0.0
simulation.nbsteps = 1
simulation.samplerate = 1

viscosity.enable = 1
viscosity.value = 0.01

spring.enable = 1
spring.scale = 1.0

#All bonded families on. The protein ones are listed too and simply have
#nothing to act on here -- a DNA file resolves no PHI/PSI/OMEGA/chi rule.
dihedralphi.enable = 1
dihedralpsi.enable = 1
dihedralomega.enable = 1
dihedralchi.enable = 1
dihedralplanarity.enable = 1
dihedralnucleicbackbone.enable = 1
dihedralnucleicchi.enable = 1
dihedralnucleicsugar.enable = 1
